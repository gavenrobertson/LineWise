{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LineWise",
  "version": "../package.json",
  "identifier": "dev.gavenrobertson.linewise",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LineWise",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "publisher": "Gaven Robertson",
    "copyright": "© 2026 LineWise contributors. Apache-2.0.",
    "category": "DeveloperTool",
    "shortDescription": "Open-source network diagramming",
    "longDescription": "Draw Cisco-style network architecture diagrams where every icon is a real device with interfaces, IPs and VLANs.",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["lwise"],
        "name": "LineWise diagram",
        "description": "LineWise network diagram",
        "role": "Editor",
        "mimeType": "application/vnd.linewise+json"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "language": "en-US",
        "version": "1.0.0",
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp",
        "fragmentPaths": ["windows/document-icon.wxs"],
        "componentRefs": ["LwiseDocumentIcon"]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "background": "installer/dmg-background.png",
        "appPosition": {
          "x": 180,
          "y": 230
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 230
        }
      },
      "infoPlist": "Info.plist",
      "files": {
        "Resources/document.icns": "icons/document.icns"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFOTVBRTFDNzA5RjNENTIKUldSU1BaOXdISzZWRHA1ZTlFNjlqT1pFVjJSZnlTekNDWmxnSCtTM1hQcVhrUnI3VU11dEs3a3MK",
      "endpoints": ["https://github.com/gavenrobertson/linewise/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
