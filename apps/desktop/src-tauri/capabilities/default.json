{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capabilities for the main window (NFR-SEC-01).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:allow-ask",
    "dialog:allow-message",
    "allow-app-version",
    "allow-quit-app",
    "allow-print-page",
    "allow-read-text-file",
    "allow-read-binary-file",
    "allow-save-atomic",
    "allow-write-binary-atomic",
    "allow-recovery-write",
    "allow-recovery-list",
    "allow-recovery-clear",
    "allow-take-pending-opens",
    "allow-check-update",
    "allow-install-update",
    "allow-open-external",
    "allow-open-logs-folder",
    "allow-pick-open",
    "allow-pick-save",
    "allow-recent-list",
    "allow-recent-add"
  ]
}
