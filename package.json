{
  "name": "linewise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @linewise/desktop dev",
    "tauri": "pnpm --filter @linewise/desktop tauri",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "build": "pnpm -r build",
    "e2e": "pnpm --filter @linewise/desktop e2e",
    "licenses:check": "node scripts/check-licenses.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "prepare": "husky",
    "schema": "pnpm --filter @linewise/core exec cross-env UPDATE_SCHEMA=1 vitest run test/jsonSchema.test.ts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "traceability": "node scripts/traceability.mjs --summary",
    "version:check": "node scripts/version.mjs check",
    "bench": "pnpm --filter @linewise/bench bench",
    "fuzz": "pnpm --filter @linewise/parsers --filter @linewise/core exec vitest run -t fuzz"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
